{
  "expo": {
    "name": "Atlas",
    "slug": "Bilal_Project",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/atlas-icon.png",
    "scheme": "bilalproject",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.atlas.pilot",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/atlas-icon-foreground.png",
        "monochromeImage": "./assets/images/atlas-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/atlas-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/logo.png",
          "imageWidth": 200
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow $(PRODUCT_NAME) to use the camera to scan product QR codes.",
          "recordAudioAndroid": false
        }
      ],
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow $(PRODUCT_NAME) to attach photos in chat.",
          "cameraPermission": "Allow $(PRODUCT_NAME) to take photos to send in chat."
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0038cf5e-1978-4153-b8f2-73844a338c23"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/0038cf5e-1978-4153-b8f2-73844a338c23"
    }
  }
}
